# Where the API lives, no trailing slash. The app calls ${VITE_API_URL}/api/...
# Supabase Edge Function: https://<project-ref>.supabase.co/functions/v1  (set the same on Vercel)
# Leave empty to use a local `supabase functions serve` through the Vite proxy.
VITE_API_URL=

# Live updates: the project's publishable key (Dashboard → Project Settings → API Keys,
# "sb_publishable_..."). Safe in the browser — every table has RLS with no read policy.
# The Supabase URL is taken from VITE_API_URL; set VITE_SUPABASE_URL only if that differs.
VITE_SUPABASE_PUBLISHABLE_KEY=
