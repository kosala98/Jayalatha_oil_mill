# Secrets for the "api" edge function.
#   Local:  supabase functions serve api --env-file supabase/functions/.env
#   Hosted: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_DB_URL is provided by Supabase automatically; set DATABASE_URL only to override it
# (pooler-only parameters such as ?pgbouncer=true are stripped).

# At least 32 random characters. Use the SAME value the Express API had, and existing
# sessions keep working. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated frontend origins, e.g. https://mill-pos.vercel.app. Empty = any origin.
CORS_ORIGINS=

ADMIN_SESSION_TTL_MINUTES=30
USER_SESSION_TTL_MINUTES=720
BUSINESS_UTC_OFFSET_MINUTES=330
ALLOW_NEGATIVE_CHARCOAL_STOCK=false
