# ---------- Database (Supabase or Neon) ----------
# Pooled connection used by the running app.
#   Supabase: "Transaction pooler" URL (port 6543) + ?pgbouncer=true&connection_limit=5
#   Neon:     the "-pooler" host + ?pgbouncer=true&connection_limit=5
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5"
# Direct (non-pooled) connection, used only by `prisma migrate`.
#   Supabase: port 5432.  Neon: the host WITHOUT "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------- Security ----------
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# Admin session lifetime (minutes). Short on purpose.
ADMIN_SESSION_TTL_MINUTES=30
# Counter session lifetime (minutes). Long enough for a working day.
USER_SESSION_TTL_MINUTES=720
# Read ONLY by the seed script, and only where that PIN does not exist yet. 4-8 digits.
# Remove both from the environment after the first successful deploy.
INITIAL_ADMIN_PIN=""
# The PIN the counter staff use. Must be different from the admin PIN.
INITIAL_USER_PIN=""

# ---------- HTTP ----------
PORT=8080
# Comma-separated allowed frontend origins (your Vercel URL). Empty in single-server mode.
CORS_ORIGINS="http://localhost:5173"
# Number of reverse proxies in front of the app (Railway / Render = 1).
# Required for correct client IPs in the PIN rate limiter.
TRUST_PROXY=1
# Single-server mode: path to the built client, e.g. ../client/dist. Empty otherwise.
SERVE_CLIENT_DIR=""

# ---------- Business rules ----------
# Sri Lanka is UTC+5:30 = 330 minutes. Drives today / this week / this month / this year.
BUSINESS_UTC_OFFSET_MINUTES=330
# Allow charcoal sales that exceed recorded charcoal stock? Recommended: false
ALLOW_NEGATIVE_CHARCOAL_STOCK=false
