// Coconut oil mill POS — database schema
// Money: DECIMAL(16,2). Quantities: DECIMAL(12,3). Never floats.
// Financial rows are never hard-deleted: is_deleted + deleted_at + delete_reason.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UnitType {
  LITER
  KG
  BOTTLE
}

enum BottleSize {
  QUARTER // 1/4 L
  HALF // 1/2 L
  ONE // 1 L
}

enum PaymentMethod {
  CASH
  CHEQUE
  CREDIT // ණය — settled later through CustomerPayment. Requires a customer.
}

/// Cash handed over for goods already taken, or cash lent either way. The arithmetic
/// is the same — only what it means to the two people differs — so it is a label, and
/// the balance formula never has to know about it.
enum PaymentKind {
  SETTLEMENT
  LOAN
}

/// Which way money moved when a customer settles up.
enum PaymentDirection {
  RECEIVED // customer paid us (reduces what they owe)
  PAID // we paid the customer (reduces what we owe them)
}

enum PurchaseMaterial {
  COPRA // කොපරා
  CHARCOAL // පොල්කටු අඟුරු (raw charcoal material — feeds charcoal stock)
  OTHER // වෙනත් (custom_name required)
}

enum CashEntryType {
  OPENING_FLOAT
  TOP_UP
  EXPENSE // වියදම් — leaves the drawer. Note is required.
}

enum AuditAction {
  CREATE
  DELETE
  UPDATE
}

enum AuditEntity {
  SALE
  PURCHASE
  CASH_ENTRY
  ADMIN_SETTINGS
  DEVICE
  CUSTOMER
  CUSTOMER_PAYMENT
  CHARCOAL_ADJUSTMENT
  TEMP_ACCESS
  CREDENTIAL
  PRICE
}

enum ActorType {
  COUNTER
  ADMIN
  SYSTEM
}

/// Two PINs open the app: one for the counter, one for the owner.
enum PinRole {
  USER
  ADMIN
}

model Product {
  code         String     @id
  nameSi       String     @map("name_si")
  nameEn       String     @map("name_en")
  isCharcoal   Boolean    @default(false) @map("is_charcoal")
  allowedUnits UnitType[] @map("allowed_units")
  sortOrder    Int        @default(0) @map("sort_order")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sales Sale[]

  @@map("products")
}

model Sale {
  id            String        @id @default(uuid()) @db.Uuid
  /// Generated on the device. Makes offline re-sends idempotent.
  clientId      String        @unique @map("client_id") @db.Uuid
  productCode   String        @map("product_code")
  product       Product       @relation(fields: [productCode], references: [code])
  unitType      UnitType      @map("unit_type")
  bottleSize    BottleSize?   @map("bottle_size")
  /// Required when product_code = 'OTHER', forbidden otherwise.
  customName    String?       @map("custom_name")
  /// Ties every row of one counter visit to a single printed bill.
  billNo        String?       @map("bill_no")
  /// Empty bottles or cans sold alongside the oil, when the customer brought none.
  containerCount Int          @default(0) @map("container_count")
  containerPrice Decimal      @default(0) @map("container_price") @db.Decimal(12, 2)
  containerTotal Decimal      @default(0) @map("container_total") @db.Decimal(16, 2)
  quantity      Decimal       @db.Decimal(12, 3)
  pricePerUnit  Decimal       @map("price_per_unit") @db.Decimal(12, 2)
  /// Computed on the server: round(quantity * price_per_unit, 2)
  total         Decimal       @db.Decimal(16, 2)
  /// One transaction can be paid three ways at once. The parts always add up to total.
  cashAmount    Decimal       @default(0) @map("cash_amount") @db.Decimal(16, 2)
  chequeAmount  Decimal       @default(0) @map("cheque_amount") @db.Decimal(16, 2)
  creditAmount  Decimal       @default(0) @map("credit_amount") @db.Decimal(16, 2)
  chequeNumber  String?       @map("cheque_number")
  /// Required when there is a cheque part: the date it can be banked.
  chequeDepositDate DateTime? @map("cheque_deposit_date") @db.Date
  /// Required when there is a credit part: who owes us for it.
  customerId    String?       @map("customer_id") @db.Uuid
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// When the sale happened at the counter (may be earlier than created_at if queued offline)
  occurredAt    DateTime      @map("occurred_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  isDeleted     Boolean       @default(false) @map("is_deleted")
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(3)
  deleteReason  String?       @map("delete_reason")
  /// The browser install that recorded it (audit only — no longer a paired device).
  installId    String?   @map("device_id") @db.Uuid

  @@index([isDeleted, occurredAt])
  @@index([productCode, isDeleted])
  @@index([customerId, isDeleted])
  @@index([billNo])
  @@index([chequeDepositDate])
  @@map("sales")
}

/// What was taken off the scale reading before paying for it: wet weight, the sacks,
/// spoiled copra, sand in the charcoal. Stored with the row so the figure can be explained
/// months later.
enum DeductionKind {
  MOISTURE
  SACK
  SPOILED
  DUST
  OTHER
}

model Purchase {
  id            String           @id @default(uuid()) @db.Uuid
  clientId      String           @unique @map("client_id") @db.Uuid
  material      PurchaseMaterial
  customName    String?          @map("custom_name")
  billNo        String?          @map("bill_no")
  /// Weight on the scale, before deductions. Null when nothing was deducted.
  grossKg       Decimal?         @map("gross_kg") @db.Decimal(12, 3)
  /// Sum of the deductions below. quantityKg = grossKg − deductionKg.
  deductionKg   Decimal          @default(0) @map("deduction_kg") @db.Decimal(12, 3)
  /// [{ kind, kg }] — the breakdown, kept so the net weight can be explained later.
  deductions    Json?
  /// Net weight, and the only figure the price is applied to.
  quantityKg    Decimal          @map("quantity_kg") @db.Decimal(12, 3)
  pricePerKg    Decimal          @map("price_per_kg") @db.Decimal(12, 2)
  total         Decimal          @db.Decimal(16, 2)
  cashAmount    Decimal          @default(0) @map("cash_amount") @db.Decimal(16, 2)
  chequeAmount  Decimal          @default(0) @map("cheque_amount") @db.Decimal(16, 2)
  creditAmount  Decimal          @default(0) @map("credit_amount") @db.Decimal(16, 2)
  chequeNumber  String?          @map("cheque_number")
  chequeDepositDate DateTime?    @map("cheque_deposit_date") @db.Date
  customerId    String?          @map("customer_id") @db.Uuid
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  occurredAt    DateTime         @map("occurred_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  isDeleted     Boolean          @default(false) @map("is_deleted")
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(3)
  deleteReason  String?          @map("delete_reason")
  /// The browser install that recorded it (audit only — no longer a paired device).
  installId    String?   @map("device_id") @db.Uuid

  @@index([isDeleted, occurredAt])
  @@index([material, isDeleted])
  @@index([customerId, isDeleted])
  @@index([billNo])
  @@index([chequeDepositDate])
  @@map("purchases")
}

model CashEntry {
  id           String        @id @default(uuid()) @db.Uuid
  clientId     String        @unique @map("client_id") @db.Uuid
  type         CashEntryType
  amount       Decimal       @db.Decimal(16, 2)
  note         String?
  occurredAt   DateTime      @map("occurred_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  isDeleted    Boolean       @default(false) @map("is_deleted")
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(3)
  deleteReason String?       @map("delete_reason")
  /// The browser install that recorded it (audit only — no longer a paired device).
  installId    String?   @map("device_id") @db.Uuid

  @@index([isDeleted, occurredAt])
  @@map("cash_entries")
}

/// A regular customer who buys or sells on credit and settles later.
/// Balance is never stored: it is always recomputed from credit rows + payments,
/// so a deleted transaction can never leave a stale debt behind.
model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  clientId     String    @unique @map("client_id") @db.Uuid
  name         String    @db.VarChar(80)
  phone        String?   @db.VarChar(20)
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  deleteReason String?   @map("delete_reason")
  /// The browser install that recorded it (audit only — no longer a paired device).
  installId    String?   @map("device_id") @db.Uuid

  sales     Sale[]
  purchases Purchase[]
  payments  CustomerPayment[]

  @@index([isDeleted, name])
  @@map("customers")
}

/// Money moving between us and a customer to settle credit. Cash payments move the
/// drawer; cheques do not until they clear, exactly like sales and purchases.
model CustomerPayment {
  id                String           @id @default(uuid()) @db.Uuid
  clientId          String           @unique @map("client_id") @db.Uuid
  customerId        String           @map("customer_id") @db.Uuid
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  billNo            String?          @map("bill_no")
  kind              PaymentKind      @default(SETTLEMENT)
  direction         PaymentDirection
  /// CASH or CHEQUE only — settling a debt with more credit is not a payment.
  method            PaymentMethod
  amount            Decimal          @db.Decimal(16, 2)
  chequeNumber      String?          @map("cheque_number")
  chequeDepositDate DateTime?        @map("cheque_deposit_date") @db.Date
  note              String?
  occurredAt        DateTime         @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  isDeleted         Boolean          @default(false) @map("is_deleted")
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(3)
  deleteReason      String?          @map("delete_reason")
  /// The browser install that recorded it (audit only — no longer a paired device).
  installId    String?   @map("device_id") @db.Uuid

  @@index([customerId, isDeleted])
  @@index([isDeleted, occurredAt])
  @@index([billNo])
  @@index([chequeDepositDate])
  @@map("customer_payments")
}

/// Corrects computed charcoal stock against what is actually in the store.
/// Signed delta, never a hard edit of the underlying purchases and sales.
model CharcoalAdjustment {
  id         String   @id @default(uuid()) @db.Uuid
  clientId   String   @unique @map("client_id") @db.Uuid
  /// Stock the system had computed at the moment of the correction.
  previousKg Decimal  @map("previous_kg") @db.Decimal(12, 3)
  /// What the admin says is actually there (usually 0 when clearing a leftover).
  countedKg  Decimal  @map("counted_kg") @db.Decimal(12, 3)
  /// counted − previous. Added to the computed stock from now on.
  deltaKg    Decimal  @map("delta_kg") @db.Decimal(12, 3)
  reason     String
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The browser install that recorded it (audit only — no longer a paired device).
  installId    String?   @map("device_id") @db.Uuid

  @@index([occurredAt])
  @@map("charcoal_adjustments")
}

/// The standing price of one thing: a litre of coconut oil, a half-litre bottle of it,
/// a kilo of copra. Set once and kept until someone changes it — never daily-expiring.
/// The id is a slug the app builds: "sale:COCONUT_OIL:LITER", "sale:RBD_OIL:BOTTLE:HALF",
/// "purchase:COPRA". Unknown ids are simply ignored, so new kinds of price need no migration.
model Price {
  id        String   @id
  amount    Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  installId String?  @map("device_id") @db.Uuid

  @@map("prices")
}

/// One row per PIN. The counter PIN opens the app; the admin PIN opens the books.
model Credential {
  role           PinRole   @id
  pinHash        String    @map("pin_hash")
  /// Bumped on every change; embedded in session tokens so old sessions die.
  pinVersion     Int       @default(1) @map("pin_version")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("credentials")
}

/// Lets counter sessions into the admin screens for a while, without the admin PIN.
model TemporaryAdminAccess {
  id        String    @id @default(uuid()) @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("temporary_admin_access")
}

/// Append-only trail of every create/delete on financial rows (and PIN changes).
model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  action    AuditAction
  entity    AuditEntity
  entityId  String      @map("entity_id")
  actor     ActorType
  /// Paired device id when the request carried a valid device token,
  /// otherwise the random per-install id the app sends in X-Device-Id
  deviceId  String?     @map("device_id")
  ip        String?
  userAgent String?     @map("user_agent")
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
